# ==========================================================
# Variables de entorno - API de Reservaciones de Restaurante
# ==========================================================
# Copia este archivo como ".env" y reemplaza los valores de
# ejemplo con tus credenciales reales.
# El archivo ".env" NUNCA debe subirse a GitHub (ya está
# excluido en .gitignore) porque contiene datos sensibles.
# ==========================================================

# Puerto en el que corre el servidor en modo local.
# Railway asigna su propio puerto automáticamente en producción,
# así que esta variable solo aplica quese usa localmente.
PORT=3000

# Connection string de PostgreSQL (Neon).
# Se obtiene desde el dashboard de Neon: botón "Connect".
# Formato: postgresql://usuario:password@host.neon.tech/dbname?sslmode=require
# IMPORTANTE: sslmode=require es obligatorio, Neon no acepta
# conexiones sin SSL.
DATABASE_URL=postgresql://usuario:password@host.neon.tech/dbname?sslmode=require

# Clave secreta usada para firmar y verificar los tokens JWT.
# Debe ser larga, aleatoria e imposible de adivinar.
# Se puede generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia_este_valor_por_uno_seguro_y_aleatorio

# Tiempo de expiración del token JWT.
# Acepta formatos como: 60 (segundos), "2h" (horas), "4d" (días).
JWT_EXPIRES_IN=4d